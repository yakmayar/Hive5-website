---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Carousel from '../components/Carousel.astro';

// Product cards. "subtitle" is the small line under the title (optional).
const products = [
  {
    image: '/images/bottle.jpg',
    alt: 'Bottle of Hive Five Apiary raw honey with our hives in the background',
    title: 'Liquid Honey',
    subtitle: 'Bottle',
    description: 'Raw, unfiltered honey in a 1lb. plastic bottle. Perfect for drizzling over toast, yogurt, or tea!'
  },
  {
    image: '/images/honey-jar-dipper.jpg',
    alt: 'Glass jar of Hive Five Apiary raw honey with a wooden honey dipper',
    title: 'Liquid Honey',
    subtitle: 'with dipper',
    description: 'A larger, glass jar with a convenient wooden honey dipper. Elegant and a perfect gift!'
  },
  {
    image: '/images/creamed-honey.jpg',
    alt: 'Jar of Hive Five Apiary creamed honey',
    title: 'Creamed Honey',
    description: 'Smooth creamed honey with a rich and thick texture. Perfect for spreading on bread!'
  },
  {
    image: '/images/lip-balm.jpg',
    alt: 'Hive Five Apiary lip balm in its tin, with an open tin beside it',
    title: 'Lip Balm',
    description: 'Lip Balm made with Organic Virgin Coconut Oil, Beeswax from our bees, Cocoa Butter, Extra Virgin Olive Oil, Sweet Almond Oil, Jojoba Oil, Vitamin E, Lanolin, and Flavoring Oil. It comes in a 1oz. reusable tin.'
  }
];

// Photos for the carousel next to the intro text.
const productionImages = [
  { src: '/images/product1.jpg', alt: 'A jar of our honey in front of our colorful hives' },
  { src: '/images/product2.jpg', alt: 'A frame of capped honey lifted from a honey super' },
  { src: '/images/product3.jpg', alt: 'Honey frames loaded into our extractor' },
  { src: '/images/product4.jpg', alt: 'Extracted honey running through a sieve into a bucket' },
  { src: '/images/product5.jpg', alt: 'Stirring honey in a glass bowl to make creamed honey' }
];
---

<BaseLayout
  title="Products"
  description="Raw local honey, creamed honey and beeswax lip balm from Hive Five Apiary, a Certified North Carolina Honey Producer in Midtown Raleigh."
>
  <div class="relative min-h-screen overflow-x-clip bg-gradient-to-br from-amber-50 via-yellow-50 to-orange-50">
    <!-- Honeycomb background pattern -->
    <div class="fixed inset-0 opacity-10 pointer-events-none">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>

    <PageHeader
      eyebrow="From our backyard"
      title="Our Products"
      intro="Pure local honey from our backyard to your table."
    />

    <!-- How we make it: photos + story -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-5">
          <Carousel images={productionImages} label="Photos of how we make our honey products" aspect="1 / 1" eager />
        </div>

        <div class="lg:col-span-7 bg-white/60 backdrop-blur-sm rounded-3xl shadow-lg ring-1 ring-amber-900/5 p-6 sm:p-8 lg:p-10 space-y-5 text-gray-700 text-lg leading-relaxed">
          <p>
            All of our honey products come from our small backyard apiary in the North Hills (Midtown) area of Raleigh. Honeybees are known for foraging up to 3 miles away, so our bees gather nectar from many different plant species depending on what our neighbors have growing in their yards. This creates honey with unique flavors that reflect our neighborhood's botanical diversity.
          </p>
          <p>
            We take a natural approach with our own yard, avoiding lawn treatments and chemical applications. Instead, we focus on growing native plants and maintaining a year-round garden. We vermicompost most of our food waste and have chickens that help eat food scraps and compost our leaf pile—all part of our little urban homestead.
          </p>
          <p>
            We collect our honey from smaller boxes on our hives called honey supers, which lets our bees keep what they've stored in the brood and deep boxes to help them survive throughout the four seasons. The cappings are scraped off from the honey, and the frames are placed into our extractor. The extractor spins the honey from our frames, and it runs down through a sieve that removes chunks of wax or other large particles. From there, the honey goes into bottles or is transformed into creamed honey.
          </p>
          <p>
            We practice minimal intervention beekeeping, so any wax we collect comes from inspections where extra comb is built in the wrong place or from our extraction process when removing cappings. We use this small amount of wax in hand lotion, lip balm, and cutting board oil—nothing goes to waste in our sustainable approach to beekeeping.
          </p>
        </div>
      </div>
    </section>

    <!-- Product cards -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14" aria-labelledby="products-heading">
      <div class="text-center mb-10 sm:mb-14">
        <h2 id="products-heading" class="text-3xl sm:text-4xl font-semibold text-amber-900">What we offer</h2>
        <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-amber-500"></div>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        {products.map((product) => (
          <li class="product-card group flex flex-col items-center text-center bg-white/60 backdrop-blur-sm rounded-3xl shadow-lg ring-1 ring-amber-900/5 px-6 pt-8 pb-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-amber-400/40">
            <div class="hex-frame">
              <img
                src={product.image}
                alt={product.alt}
                class="hex-img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="mt-6 text-2xl font-semibold text-amber-900 leading-tight">{product.title}</h3>
            {product.subtitle && (
              <p class="mt-1 text-sm font-semibold uppercase tracking-[0.15em] text-amber-600">{product.subtitle}</p>
            )}
            <p class="mt-3 text-gray-700 leading-relaxed">{product.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Certified NC Honey + contact -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16 sm:pb-20">
      <div class="max-w-3xl mx-auto bg-amber-100/80 backdrop-blur-sm rounded-3xl shadow-lg ring-1 ring-amber-900/5 p-6 sm:p-10 text-center">
        <h2 class="text-2xl sm:text-3xl font-semibold text-amber-900 mb-4">Certified North Carolina Honey</h2>
        <p class="text-gray-700 leading-relaxed mb-6">
          Our honey is part of the Certified Honey Producer program through the North Carolina State Beekeepers Association. This certification ensures our honey meets strict quality standards and is produced right here in North Carolina.
        </p>
        <a
          href="https://www.ncbeekeepers.org/programs/certified-honey-producer"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-2xl"
        >
          <img
            src="/images/Certified-Honey-Label.png"
            alt="NC Certified Honey Producer"
            class="h-36 sm:h-40 w-auto mx-auto hover:scale-105 transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="mx-auto my-8 h-px w-24 bg-amber-300"></div>

        <h3 class="text-xl sm:text-2xl font-semibold text-amber-900 mb-3">Interested in Our Products?</h3>
        <p class="text-gray-700 leading-relaxed mb-6 max-w-xl mx-auto">
          We produce limited quantities of honey and honey products based on what our bees provide each season. If you'd like to learn more about availability or place an order, please get in touch!
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold py-3 px-8 rounded-full transition-colors duration-300 shadow-lg shadow-amber-600/20"
        >
          Contact Us
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>
  </div>

  <style>
    /* Hexagon photo with a honey-coloured edge. */
    .hex-frame {
      --hex: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      position: relative;
      width: min(100%, 15rem);
      aspect-ratio: 0.866;
      background: linear-gradient(135deg, #fcd34d 0%, #f59e0b 100%);
      clip-path: var(--hex);
      filter: drop-shadow(0 10px 18px rgb(120 53 15 / 0.18));
      transition: background 0.35s ease, transform 0.35s ease;
    }
    .hex-img {
      position: absolute;
      inset: 4px;
      width: calc(100% - 8px);
      height: calc(100% - 8px);
      object-fit: cover;
      clip-path: var(--hex);
      transition: transform 0.5s ease;
    }
    .product-card:hover .hex-frame {
      background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%);
    }
    .product-card:hover .hex-img {
      transform: scale(1.04);
    }
  </style>
</BaseLayout>
