---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const products = [
  { image: '/images/bottle.jpg', alt: 'Bottle of Hive Five Apiary raw honey with our hives in the background', title: 'Liquid honey', sub: 'Bottle',
    text: 'Raw, unfiltered honey in a 1lb. plastic bottle. Perfect for drizzling over toast, yogurt, or tea!' },
  { image: '/images/honey-jar-dipper.jpg', alt: 'Glass jar of Hive Five Apiary raw honey with a wooden honey dipper', title: 'Liquid honey', sub: 'With dipper',
    text: 'A larger, glass jar with a convenient wooden honey dipper. Elegant and a perfect gift!' },
  { image: '/images/creamed-honey.jpg', alt: 'Jar of Hive Five Apiary creamed honey', title: 'Creamed honey', sub: '',
    text: 'Smooth creamed honey with a rich and thick texture. Perfect for spreading on bread!' },
  { image: '/images/lip-balm.jpg', alt: 'Hive Five Apiary lip balm in its tin, with an open tin beside it', title: 'Lip balm', sub: '1 oz reusable tin',
    text: 'Made with Organic Virgin Coconut Oil, Beeswax from our bees, Cocoa Butter, Extra Virgin Olive Oil, Sweet Almond Oil, Jojoba Oil, Vitamin E, Lanolin, and Flavoring Oil.' },
];

const steps = [
  { image: '/images/product2.jpg', alt: 'A frame of capped honey lifted from a honey super', title: 'Pull capped frames', text: 'From the honey supers on top of each hive.' },
  { image: '/images/product3.jpg', alt: 'Honey frames loaded into our extractor', title: 'Spin', text: 'Uncapped frames go into the extractor.' },
  { image: '/images/product4.jpg', alt: 'Extracted honey running through a sieve into a bucket', title: 'Strain', text: 'A sieve catches chunks of wax and other particles.' },
  { image: '/images/product5.jpg', alt: 'Stirring honey in a glass bowl to make creamed honey', title: 'Bottle or cream', text: 'Into bottles, or transformed into creamed honey.' },
];
---

<BaseLayout
  title="Products"
  description="Raw local honey, creamed honey and beeswax lip balm from Hive Five Apiary, a Certified North Carolina Honey Producer in Midtown Raleigh."
>
  <Hero
    title="Pure local honey from our backyard to your table"
    intro="All of our honey products come from our small backyard apiary in the North Hills (Midtown) area of Raleigh."
    image="/images/product1.jpg"
    position="65% 50%"
  />

  <section class="wrap goods">
    <h2 class="section-title">What we make</h2>
    <p class="lede">We produce limited quantities of honey and honey products based on what our bees provide each season.</p>
    <div class="strip">
      {products.map((p) => (
        <article class="item">
          <img class="hex" src={p.image} alt={p.alt} loading="lazy" decoding="async" />
          <h3>{p.title}{p.sub && <small>{p.sub}</small>}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="process">
    <div class="wrap">
      <h2 class="section-title">From frame to jar</h2>
      <p class="lede">We collect our honey from smaller boxes on our hives called honey supers, which lets our bees keep what they've stored in the brood and deep boxes to help them survive throughout the four seasons.</p>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="n" aria-hidden="true">{i + 1}</span>
            <div class="photo round"><img src={s.image} alt={s.alt} loading="lazy" decoding="async" /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="lede wax">We practice minimal intervention beekeeping, so any wax we collect comes from inspections where extra comb is built in the wrong place or from our extraction process when removing cappings. We use this small amount of wax in hand lotion, lip balm, and cutting board oil—nothing goes to waste in our sustainable approach to beekeeping.</p>
    </div>
  </section>

  <div class="wrap">
    <div class="order">
      <div>
        <h2>Interested in our products?</h2>
        <p>If you'd like to learn more about availability or place an order, please get in touch!</p>
      </div>
      <a class="btn btn-primary" href="/contact">Contact us</a>
    </div>

    <div class="note">
      <a href="https://www.ncbeekeepers.org/programs/certified-honey-producer" target="_blank" rel="noopener noreferrer">
        <img src="/images/Certified-Honey-Label.png" alt="NC Certified Honey Producer" loading="lazy" />
      </a>
      <p>Our honey is part of the Certified Honey Producer program through the North Carolina State Beekeepers Association.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .goods { padding-block: 60px 40px; }
  .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; margin-top: 46px; align-items: start; }
  .item:nth-child(even) { margin-top: 90px; }
  .item img { width: 100%; aspect-ratio: 1 / 1.1547; object-fit: cover; display: block; }
  .item h3 { margin-top: 20px; font-size: 1.6rem; line-height: 1.15; }
  .item h3 small { display: block; font: 500 .9rem var(--font-sans); color: var(--color-amber); margin-top: 4px; }
  .item p { color: var(--color-bark-2); font-size: 1rem; margin-top: 8px; }

  .process { padding-block: 90px; margin-top: 40px; background: linear-gradient(180deg, var(--color-light), #fbf1da 30%, #fbf1da 70%, var(--color-light)); }
  .steps { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin: 46px 0 0; padding: 0; list-style: none; }
  .steps::before { content: ""; position: absolute; left: 8%; right: 8%; top: 118px; border-top: 2px dotted rgb(184 103 13 / .55); }
  .step { position: relative; text-align: center; }
  .step .round { width: 236px; aspect-ratio: 1; margin: 0 auto; border-radius: 50%; border: 6px solid var(--color-light); }
  .step .n { position: absolute; top: 4px; left: calc(50% - 128px); z-index: 1; width: 40px; height: 46px; clip-path: var(--hex); background: var(--color-honey); display: grid; place-items: center; font: 600 1.1rem var(--font-display); color: #2a1c0e; }
  .step h3 { margin-top: 20px; font-size: 1.4rem; }
  .step p { color: var(--color-bark-2); font-size: 1rem; margin-top: 6px; }
  .wax { margin-top: 50px; }

  .order { margin-block: 70px 50px; display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: center; padding: 44px 48px; border-radius: 32px; background: #fff; box-shadow: 0 14px 34px rgb(59 42 26 / .1); }
  .order h2 { font-size: 2.1rem; }
  .order p { color: var(--color-bark-2); margin-top: 8px; max-width: 40em; }

  .note { padding: 10px 0 70px; display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; }
  .note img { width: 110px; transition: transform .3s; }
  .note a:hover img { transform: scale(1.05); }
  .note p { font: italic 1.5rem/1.35 var(--font-display); color: var(--color-bark-2); max-width: 36em; }

  @media (max-width: 900px) {
    .strip { grid-template-columns: 1fr 1fr; gap: 18px; }
    .item:nth-child(even) { margin-top: 60px; }
    .item h3 { font-size: 1.3rem; }
    .steps { grid-template-columns: 1fr 1fr; } .steps::before { display: none; }
    .step .round { width: 150px; } .step .n { left: 4px; }
    .order { grid-template-columns: 1fr; padding: 30px 24px; }
    .note { grid-template-columns: 1fr; } .note p { font-size: 1.25rem; }
  }
</style>
