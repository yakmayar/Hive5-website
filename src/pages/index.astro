---
import BaseLayout from '../layouts/BaseLayout.astro';

const hexagons = [
  { image: '/images/hex2.jpg', title: 'About Us', link: '/about' },
  { image: '/images/hex3.jpg', title: 'Our Bees', link: '/bees' },
  { image: '/images/hex4.jpg', title: 'Products', link: '/products' },
  { image: '/images/hex5.jpg', title: 'Contact', link: '/contact' }
];
---

<BaseLayout title="Home">
  <div class="min-h-screen bg-gradient-to-br from-amber-50 via-yellow-50 to-orange-50 overflow-hidden relative">
    <!-- Honeycomb background pattern -->
    <div class="fixed inset-0 opacity-10 pointer-events-none">
      <div class="absolute inset-0 bg-pattern"></div>
    </div>

    <!-- Hero: the logo is the centerpiece -->
    <header class="relative z-10 flex justify-center px-4 pt-10 pb-8 sm:pt-14 sm:pb-12">
      <!-- Soft warm glow behind the logo -->
      <div class="hero-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>

      <h1 class="relative hero-enter">
        <img
          src="/images/logo.png"
          alt="Hive Five Apiary"
          width="520"
          height="520"
          fetchpriority="high"
          decoding="async"
          class="hero-float block w-[min(620px,92vw)] -my-6 sm:-my-10 h-auto drop-shadow-2xl"
        />
      </h1>
    </header>

    <!-- Honeycomb navigation -->
    <nav class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20" aria-label="Explore Hive Five Apiary">
      <ul class="hex-grid">
        {hexagons.map((hex) => (
          <li>
            <a href={hex.link} class="hex">
              <span class="hex-frame">
                <span class="hex-inner">
                  <img src={hex.image} alt="" decoding="async" class="hex-img" />
                  <span class="hex-shade" aria-hidden="true"></span>
                  <span class="hex-label font-display">{hex.title}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- CTA over two North Hills photos -->
    <section class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20">
      <div class="relative overflow-hidden rounded-3xl shadow-lg ring-1 ring-amber-900/10">
        <div class="absolute inset-0 grid grid-cols-2">
          <img
            src="/images/north-hills1.jpg"
            alt="Aerial view of North Hills in Raleigh"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <img
            src="/images/north-hills2.jpg"
            alt="Aerial view of the North Hills town center"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Overlay for text readability -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/35 to-black/25"></div>

        <div class="relative px-6 py-20 sm:py-28 text-center">
          <h2 class="cta-text text-4xl sm:text-5xl lg:text-6xl font-semibold text-white mb-4">
            Give Nature a Hive Five!
          </h2>
          <p class="cta-text text-lg sm:text-2xl text-amber-50 font-light">
            Located in Midtown Raleigh
          </p>
        </div>
      </div>
    </section>
  </div>

  <style>
    /* ---- Hero ---- */
    .hero-glow {
      background: radial-gradient(ellipse 55% 60% at 50% 45%, rgb(255 255 255 / 0.65), rgb(254 243 199 / 0.35) 45%, transparent 75%);
    }

    .hero-enter {
      animation: hero-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-float {
      animation: hero-float 7s ease-in-out 1s infinite;
    }

    @keyframes hero-enter {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes hero-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    /* ---- Honeycomb navigation ---- */
    .hex-grid {
      --hex-w: min(calc((100vw - 2rem - 0.75rem) / 2), 220px);
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    @media (min-width: 768px) {
      .hex-grid { --hex-w: 160px; gap: 1rem; }
    }
    @media (min-width: 900px) {
      .hex-grid { --hex-w: 200px; }
    }
    @media (min-width: 1024px) {
      .hex-grid { --hex-w: 240px; gap: 1.25rem; }
    }
    @media (min-width: 1280px) {
      .hex-grid { --hex-w: 270px; }
    }

    .hex {
      display: block;
      width: var(--hex-w);
      aspect-ratio: 1 / 1.1547;
      text-decoration: none;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
      filter: drop-shadow(0 6px 10px rgb(120 53 15 / 0.18));
    }

    .hex-frame,
    .hex-inner {
      position: absolute;
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    }

    .hex { position: relative; }

    /* Honey-colored border */
    .hex-frame {
      inset: 0;
      background: linear-gradient(135deg, #fcd34d 0%, #f59e0b 100%);
      transition: background 0.4s ease;
    }

    .hex-inner {
      inset: 4px;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: #92400e;
    }

    .hex-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.92) saturate(1.05);
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
    }

    .hex-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.4));
      transition: opacity 0.4s ease;
    }

    .hex-label {
      position: relative;
      padding: 0 0.75rem;
      color: #fff;
      font-weight: 600;
      font-size: clamp(1.35rem, 5.5vw, 1.6rem);
      line-height: 1.1;
      text-align: center;
      letter-spacing: -0.01em;
      text-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 2px 12px rgb(0 0 0 / 0.35);
    }

    @media (min-width: 1024px) {
      .hex-label { font-size: 1.9rem; }
    }

    .hex:hover,
    .hex:focus-visible {
      transform: translateY(-4px) scale(1.03);
      filter: drop-shadow(0 12px 20px rgb(180 83 9 / 0.3));
    }

    .hex:hover .hex-frame,
    .hex:focus-visible .hex-frame {
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
    }

    .hex:hover .hex-img,
    .hex:focus-visible .hex-img {
      transform: scale(1.06);
      filter: brightness(1.05) saturate(1.15);
    }

    .hex:hover .hex-shade,
    .hex:focus-visible .hex-shade {
      opacity: 0.7;
    }

    /* Keyboard focus: hover state plus a soft ring set away from the shape. */
    .hex:focus-visible {
      outline: 3px solid var(--color-honey-500);
      outline-offset: 6px;
      border-radius: 1rem;
    }

    /* ---- CTA ---- */
    .cta-text {
      text-shadow: 0 1px 2px rgb(0 0 0 / 0.35), 0 4px 24px rgb(0 0 0 / 0.3);
    }
  </style>
</BaseLayout>
