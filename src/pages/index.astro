---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// The four sections, as honeycomb cells. Positions are for the 10%-larger
// cluster from the approved design (209 x 241 cells, 9px gaps).
const cells = [
  { href: '/about', title: 'About us', sub: 'How it all started', image: '/images/hex2.jpg', x: 0, y: 0 },
  { href: '/bees', title: 'Our bees', sub: 'Colonies, queens and care', image: '/images/our-colonies2.jpg', x: 218, y: 0 },
  { href: '/products', title: 'Products', sub: 'Honey and lip balm', image: '/images/hex4.jpg', x: 327, y: 188 },
  { href: '/contact', title: 'Contact', sub: 'Say hello', image: '/images/hex5.jpg', x: 218, y: 376, pos: 'center 30%' },
];
---

<BaseLayout title="Home">
  <div class="home-top">
    <Hero
      tall
      title="Backyard beekeeping in Midtown Raleigh"
      intro="We're hobby beekeepers with a handful of hives in our backyard. Our Italian and Caucasian bees forage the gardens and trees of North Hills."
      image="/images/care3.jpg"
    >
      <div class="ctas">
        <a class="btn btn-primary" href="/bees">Meet our bees</a>
        <a class="btn btn-ghost" href="/about">Our story</a>
      </div>
    </Hero>

    <!-- A bee's dotted flight path from the comb photo down to the honeycomb -->
    <svg class="flight" width="1440" height="460" viewBox="0 0 1440 460" aria-hidden="true">
      <path d="M1200 60 C1330 110 1350 230 1230 240 C1110 250 1130 130 1235 150 C1340 170 1300 330 1120 360 C980 405 800 440 700 400" />
    </svg>
    <img class="flight-bee" src="/images/bee-mark.png" alt="" width="44" height="44" />

    <section class="explore">
      <div class="explore-text">
        <h2 class="section-title">How it started</h2>
        <p class="lede">We took our first beekeeping classes in 2018, as part of turning our suburban yard into a little homestead with a garden and chickens. The bees were a way to help our neighborhood's wildlife flourish, and they've kept us curious ever since. This is where we share what we're learning.</p>
      </div>
      <nav class="comb" aria-label="Explore the site">
        <svg class="trail" width="488" height="561" viewBox="0 0 488 561" aria-hidden="true"><g fill="none" stroke="#d9a441" stroke-width="1.6"><polygon points="-400,171 -305,225.75 -305,335.25 -400,390 -495,335.25 -495,225.75" transform="translate(4 4) scale(0.96)" transform-origin="-400 280.5" style="opacity:0.13"/><polygon points="-202,171 -107,225.75 -107,335.25 -202,390 -297,335.25 -297,225.75" transform="translate(4 4) scale(0.96)" transform-origin="-202 280.5" style="opacity:0.24"/><polygon points="-4,171 91,225.75 91,335.25 -4,390 -99,335.25 -99,225.75" transform="translate(4 4) scale(0.96)" transform-origin="-4 280.5" style="opacity:0.34"/><polygon points="-499,342 -404,396.75 -404,506.25 -499,561 -594,506.25 -594,396.75" transform="translate(4 4) scale(0.96)" transform-origin="-499 451.5" style="opacity:0.09"/><polygon points="-301,342 -206,396.75 -206,506.25 -301,561 -396,506.25 -396,396.75" transform="translate(4 4) scale(0.96)" transform-origin="-301 451.5" style="opacity:0.21"/><polygon points="-103,342 -8,396.75 -8,506.25 -103,561 -198,506.25 -198,396.75" transform="translate(4 4) scale(0.96)" transform-origin="-103 451.5" style="opacity:0.32"/><polygon points="95,342 190,396.75 190,506.25 95,561 0,506.25 0,396.75" transform="translate(4 4) scale(0.96)" transform-origin="95 451.5" style="opacity:0.44"/><polygon points="-400,513 -305,567.75 -305,677.25 -400,732 -495,677.25 -495,567.75" transform="translate(4 4) scale(0.96)" transform-origin="-400 622.5" style="opacity:0.13"/><polygon points="-202,513 -107,567.75 -107,677.25 -202,732 -297,677.25 -297,567.75" transform="translate(4 4) scale(0.96)" transform-origin="-202 622.5" style="opacity:0.24"/><polygon points="-4,513 91,567.75 91,677.25 -4,732 -99,677.25 -99,567.75" transform="translate(4 4) scale(0.96)" transform-origin="-4 622.5" style="opacity:0.34"/><polygon points="194,513 289,567.75 289,677.25 194,732 99,677.25 99,567.75" transform="translate(4 4) scale(0.96)" transform-origin="194 622.5" style="opacity:0.41"/><polygon points="-301,684 -206,738.75 -206,848.25 -301,903 -396,848.25 -396,738.75" transform="translate(4 4) scale(0.96)" transform-origin="-301 793.5" style="opacity:0.12"/><polygon points="-103,684 -8,738.75 -8,848.25 -103,903 -198,848.25 -198,738.75" transform="translate(4 4) scale(0.96)" transform-origin="-103 793.5" style="opacity:0.21"/><polygon points="95,684 190,738.75 190,848.25 95,903 0,848.25 0,738.75" transform="translate(4 4) scale(0.96)" transform-origin="95 793.5" style="opacity:0.27"/><polygon points="293,684 388,738.75 388,848.25 293,903 198,848.25 198,738.75" transform="translate(4 4) scale(0.96)" transform-origin="293 793.5" style="opacity:0.29"/><polygon points="-202,855 -107,909.75 -107,1019.25 -202,1074 -297,1019.25 -297,909.75" transform="translate(4 4) scale(0.96)" transform-origin="-202 964.5" style="opacity:0.07"/><polygon points="-4,855 91,909.75 91,1019.25 -4,1074 -99,1019.25 -99,909.75" transform="translate(4 4) scale(0.96)" transform-origin="-4 964.5" style="opacity:0.13"/><polygon points="194,855 289,909.75 289,1019.25 194,1074 99,1019.25 99,909.75" transform="translate(4 4) scale(0.96)" transform-origin="194 964.5" style="opacity:0.16"/></g></svg>
        <div class="cell honey" style="left:109px;top:188px" aria-hidden="true"></div>
        {cells.map((c) => (
          <a class="cell" href={c.href} style={`left:${c.x}px;top:${c.y}px;background-image:url(${c.image});background-position:${c.pos ?? 'center'}`}>
            <span>{c.title}<small>{c.sub}</small></span>
          </a>
        ))}
      </nav>
    </section>
  </div>

  <section class="nh">
    <div class="nh-imgs" aria-hidden="true">
      <div class="l" style="background-image:url(/images/north-hills1.jpg)"></div>
      <div class="r" style="background-image:url(/images/north-hills2.jpg)"></div>
    </div>
    <div class="nh-text">
      <h2>Give Nature a Hive Five!</h2>
      <p>Located in Midtown Raleigh</p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-top { position: relative; overflow-x: clip; }

  .flight { position: absolute; right: 0; top: 700px; pointer-events: none; z-index: 3; overflow: visible; }
  .flight path { fill: none; stroke: var(--color-amber); stroke-width: 2; stroke-dasharray: 2 9; stroke-linecap: round; opacity: .65; }
  .flight-bee { position: absolute; right: 746px; top: 1066px; width: 44px; height: 44px; transform: rotate(-12deg); z-index: 3; pointer-events: none; }

  .explore { position: relative; display: grid; grid-template-columns: 1fr 560px; gap: 40px; align-items: center; padding: 200px 56px 150px; -webkit-mask-image: linear-gradient(#000 calc(100% - 160px), transparent); mask-image: linear-gradient(#000 calc(100% - 160px), transparent); }
  .explore-text { position: relative; z-index: 2; }
  .comb { position: relative; width: 537px; height: 617px; }
  .comb :global(.trail) { position: absolute; left: 0; top: 0; overflow: visible; pointer-events: none; transform: scale(1.1); transform-origin: 0 0; }
  .cell { position: absolute; width: 209px; height: 241px; clip-path: var(--hex); background-size: cover; display: grid; place-items: center; text-align: center; color: #fff; text-decoration: none; transition: transform .35s, filter .35s; }
  .cell::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(40 24 8 / .05), rgb(40 24 8 / .55)); }
  .cell span { position: relative; font: 600 1.7rem/1.1 var(--font-display); padding: 0 18px; text-shadow: 0 2px 10px rgb(0 0 0 / .35); }
  .cell small { display: block; font: 500 .85rem/1.35 var(--font-sans); margin-top: 6px; opacity: .92; }
  a.cell:hover { transform: scale(1.04); filter: brightness(1.08); }
  a.cell:focus-visible { outline: none; filter: brightness(1.15) saturate(1.2); }
  .cell.honey { background: linear-gradient(150deg, #f6bd45, #e39412); }
  .cell.honey::before { display: none; }

  .nh { position: relative; height: 380px; margin-top: 90px; display: grid; place-items: center; text-align: center; overflow: hidden; }
  .nh-imgs { position: absolute; inset: 0; }
  .nh-imgs div { position: absolute; top: 0; bottom: 0; width: 58%; background-size: cover; background-position: center 22%; }
  .nh-imgs .l { left: 0; }
  .nh-imgs .r { right: 0; -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%); mask-image: linear-gradient(90deg, transparent 0%, #000 22%); }
  .nh::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, var(--color-light) 0%, rgb(255 250 240 / .5) 20%, rgb(59 42 26 / .18) 42%, rgb(17 24 39 / .35) 70%, rgb(17 24 39 / .85) 90%, var(--color-slate) 100%); }
  .nh-text { position: relative; z-index: 2; color: #fff; padding: 40px 20px; }
  .nh h2 { font-size: clamp(2.3rem, 4.5vw, 3.9rem); line-height: 1.05; text-shadow: 0 2px 22px rgb(30 18 6 / .55); }
  .nh p { font-size: 1.25rem; margin-top: 10px; text-shadow: 0 1px 10px rgb(30 18 6 / .6); }

  @media (max-width: 1100px) {
    .flight, .flight-bee { display: none; }
    .explore { grid-template-columns: minmax(0, 1fr); padding: 60px 20px 80px; }
    .comb { margin-left: calc(50% - 268px); transform: scale(.64); transform-origin: top center; margin-bottom: -222px; }
    .cell span { font-size: 2rem; }
    .cell small { display: none; }
  }
  @media (min-width: 701px) and (max-width: 1100px) {
    .comb { transform: scale(.85); margin-bottom: -92px; }
  }
  @media (max-width: 700px) {
    .nh { height: 300px; margin-top: 40px; }
    .nh p { font-size: 1.05rem; }
  }
</style>
