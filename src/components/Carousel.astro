---
// Photo carousel used across the site.
// - Every photo sits in the same frame size, so sections line up.
// - The whole photo is shown (nothing cropped off); the leftover space is
//   filled with a soft blurred copy of the photo instead of black bars.
// - Swipe on phones (native scrolling), arrows + dots on desktop, arrow keys.
// - Auto-advances, but pauses on hover/touch/focus, when scrolled out of
//   view, and never for visitors who prefer reduced motion.

interface Slide {
  src: string;
  alt: string;
}

interface Props {
  images: Slide[];
  label: string;          // e.g. "Photos of our queens"
  aspect?: string;        // CSS aspect-ratio of the frame, e.g. "4 / 5"
  interval?: number;      // ms between auto-advances; 0 turns it off
  eager?: boolean;        // load the first photo immediately (above the fold)
  class?: string;
}

const { images, label, aspect = '4 / 3', interval = 6000, eager = false, class: className = '' } = Astro.props;
---

<div
  class:list={['carousel group relative', className]}
  data-carousel
  data-interval={interval}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="relative overflow-hidden rounded-2xl bg-stone-900 shadow-xl ring-1 ring-black/5" style={`aspect-ratio: ${aspect};`}>
    <ul class="carousel-track flex h-full overflow-x-auto snap-x snap-mandatory" tabindex="0">
      {images.map((img, i) => (
        <li
          class="relative h-full w-full flex-none snap-center overflow-hidden"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${images.length}`}
        >
          <img
            src={img.src}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-2xl"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <img
            src={img.src}
            alt={img.alt}
            class="relative h-full w-full object-contain"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
          />
        </li>
      ))}
    </ul>

    {images.length > 1 && (
      <>
        <button type="button" data-prev class="carousel-arrow left-3" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button type="button" data-next class="carousel-arrow right-3" aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>

        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/40 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-3 flex justify-center gap-0">
          {images.map((_, i) => (
            <button type="button" data-dot={i} class="carousel-dot" aria-label={`Show photo ${i + 1}`}></button>
          ))}
        </div>
      </>
    )}
  </div>
</div>

<style>
  .carousel-track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.9);
    color: #78350f;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.18);
    opacity: 0;
    transition: opacity 0.25s ease, background-color 0.2s ease, scale 0.2s ease;
  }
  .carousel-arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .carousel-arrow:hover {
    background: #fff;
    scale: 1.06;
  }
  @media (hover: hover) and (min-width: 640px) {
    .carousel-arrow {
      display: grid;
    }
    .carousel:hover .carousel-arrow,
    .carousel:focus-within .carousel-arrow {
      opacity: 1;
    }
  }

  .carousel-dot {
    /* 24px tap target; only the 8px centre is painted */
    box-sizing: content-box;
    padding: 8px;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: rgb(255 255 255 / 0.55);
    background-clip: content-box;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .carousel-dot[aria-current='true'] {
    width: 1.5rem;
    background-color: #fff;
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.carousel-track');
    if (!track) return;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const interval = Number(root.dataset.interval || 0);
    let index = 0;
    let timer: number | undefined;
    let paused = false;
    let visible = false;
    let userInteracted = false;

    const go = (i: number, smooth = true) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
    };

    const sync = () => {
      index = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
    };

    let scrollRaf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollRaf);
      scrollRaf = requestAnimationFrame(sync);
    }, { passive: true });

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
    });

    // Auto-advance
    const tick = () => { if (!paused && visible) go(index + 1); };
    const start = () => {
      if (!interval || reduceMotion || slides.length < 2 || userInteracted) return;
      clearInterval(timer);
      timer = window.setInterval(tick, interval);
    };
    root.addEventListener('mouseenter', () => { paused = true; });
    root.addEventListener('mouseleave', () => { paused = false; start(); });
    root.addEventListener('focusin', () => { paused = true; });
    root.addEventListener('focusout', () => { paused = false; });
    // Once someone swipes, let them browse at their own pace.
    const stop = () => { userInteracted = true; clearInterval(timer); };
    track.addEventListener('pointerdown', stop, { passive: true });
    root.querySelectorAll('button').forEach((b) => b.addEventListener('click', stop));

    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0.5 }).observe(root);

    window.addEventListener('resize', () => go(index, false));

    sync();
    start();
  });
</script>
