---
// Consistent title area at the top of each inner page.
interface Props {
  title: string;
  eyebrow?: string;   // small label above the title
  intro?: string;     // one or two sentences under the title
  showLogo?: boolean;
}

const { title, eyebrow, intro, showLogo = true } = Astro.props;
---

<header class="relative z-10 mx-auto flex max-w-7xl items-center justify-between gap-10 px-4 pt-12 pb-4 sm:px-6 sm:pt-16 lg:px-8">
  <div class="max-w-2xl">
    {eyebrow && (
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-amber-600">{eyebrow}</p>
    )}
    <h1 class="text-5xl font-semibold leading-[1.05] text-amber-900 sm:text-6xl">{title}</h1>
    <div class="mt-5 h-1 w-20 rounded-full bg-amber-500"></div>
    {intro && <p class="mt-6 text-lg leading-relaxed text-gray-700 sm:text-xl">{intro}</p>}
    <slot />
  </div>

  {showLogo && (
    <img
      src="/images/logo.png"
      alt=""
      width="208"
      height="208"
      class="hidden h-44 w-44 shrink-0 object-contain drop-shadow-xl md:block lg:h-52 lg:w-52"
      decoding="async"
    />
  )}
</header>
