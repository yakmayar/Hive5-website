---
// The bee from the Hive Five logo. Used in the menu bar and footer.
// (The cursor is public/images/bee-cursor.png; the browser-tab icons are
// public/favicon.png and public/apple-touch-icon.png.)
const { class: className = 'w-8 h-8' } = Astro.props;
---
<img src="/images/bee-mark.png" alt="" width="128" height="128" class={className} decoding="async" />
