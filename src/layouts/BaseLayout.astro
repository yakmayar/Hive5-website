---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import BeeMark from '../components/BeeMark.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Hive Five Apiary is a small backyard apiary in Midtown Raleigh, North Carolina, run by hobby beekeepers since 2018.',
  image = '/images/logo.png',
} = Astro.props;

const site = Astro.site ?? new URL('https://hive5apiary.us');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const fullTitle = title === 'Home' ? 'Hive Five Apiary | Backyard Beekeeping in Midtown Raleigh' : `${title} | Hive Five Apiary`;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/bees', label: 'Our Bees' },
  { href: '/products', label: 'Products' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#111827">

  <!-- Link previews (iMessage, Facebook, Slack, etc.) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Hive Five Apiary">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary">
</head>
<body class="site font-sans">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-amber-400 focus:text-gray-900 focus:px-4 focus:py-2 focus:rounded-full">Skip to content</a>

  <header class="topbar">
    <a href="/" class="brand">
      <BeeMark class="brand-bee" />
      <span>Hive Five Apiary</span>
    </a>
    <nav aria-label="Main">
      <ul class="menu">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <button id="mobile-menu-btn" class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <ul id="mobile-menu" class="mobile-menu" hidden>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="legal">
      <span>&copy; {year} Hive Five Apiary. All rights reserved.</span>
      <span>Midtown Raleigh, NC · <a href="mailto:hive5apiary@gmail.com">hive5apiary@gmail.com</a></span>
    </div>
  </footer>

  <style>
    .topbar { position: absolute; inset: 0 0 auto; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 56px; }
    .brand { display: flex; align-items: center; gap: 14px; font: 600 2rem/1 var(--font-display); color: var(--color-bark); text-decoration: none; }
    .brand :global(.brand-bee) { width: 64px; height: 64px; }
    .menu { display: flex; gap: 32px; list-style: none; margin: 0; padding: 15px 30px; font-size: 1.06rem; background: rgb(255 250 240 / .85); backdrop-filter: blur(8px); border-radius: 999px; box-shadow: 0 6px 20px rgb(59 42 26 / .12); }
    .menu a, .mobile-menu a { color: var(--color-bark); text-decoration: none; opacity: .8; }
    .menu a:hover { opacity: 1; }
    .menu a[aria-current='page'] { opacity: 1; text-decoration: underline; text-decoration-color: var(--color-slate); text-decoration-thickness: 2px; text-underline-offset: 7px; }
    .menu-btn { display: none; width: 48px; height: 48px; border-radius: 999px; place-items: center; background: rgb(255 250 240 / .9); color: var(--color-bark); box-shadow: 0 4px 14px rgb(59 42 26 / .12); }
    .menu-btn svg { width: 24px; height: 24px; }
    .mobile-menu { position: absolute; right: 20px; top: 84px; margin: 0; padding: 10px; list-style: none; background: var(--color-light); border-radius: 20px; box-shadow: 0 14px 34px rgb(59 42 26 / .18); min-width: 200px; }
    .mobile-menu a { display: block; padding: 10px 14px; border-radius: 12px; opacity: 1; }
    .mobile-menu a[aria-current='page'] { background: #fbefd2; }
    .site-footer { background: var(--color-slate); color: #9ca3af; padding: 0 56px 26px; font-size: .9rem; }
    .site-footer .legal { display: flex; justify-content: space-between; gap: 20px; padding-top: 18px; border-top: 1px solid rgb(255 255 255 / .12); }
    .site-footer a { color: #d1d5db; text-decoration: none; }
    .site-footer a:hover { color: #fbbf24; }
    @media (max-width: 860px) {
      .topbar { padding: 16px 20px; }
      .brand { font-size: 1.45rem; background: rgb(255 250 240 / .9); padding: 6px 16px 6px 8px; border-radius: 999px; box-shadow: 0 4px 14px rgb(59 42 26 / .12); }
      .brand :global(.brand-bee) { width: 44px; height: 44px; }
      .menu { display: none; }
      .menu-btn { display: grid; }
      .site-footer { padding: 0 20px 22px; }
      .site-footer .legal { flex-direction: column; gap: 4px; }
    }
  </style>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      const open = menu?.hasAttribute('hidden') ?? false;
      menu?.toggleAttribute('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  </script>
</body>
</html>
